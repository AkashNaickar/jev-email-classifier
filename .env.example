# Environment variables are OPTIONAL and are only used by the evaluation script
# (`npm run eval`). The extension itself never reads environment variables: the
# API key is entered in the popup and stored in chrome.storage.local.
#
# Copy this file to `.env` only if you want to run a LIVE evaluation.

# TypeSafe key — create one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Vercel AI Gateway key — create one via https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Which provider `npm run eval` uses when a key is present: typesafe | vercel-gateway
PROVIDER=
